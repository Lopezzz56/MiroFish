# =============================================================
# MiroFish-Offline Configuration
# =============================================================
# Local Neo4j and Ollama embeddings, with optional Groq generation stages.
# Copy this file to .env and adjust values for your setup.
# =============================================================

# ===== LLM Configuration (OpenAI-compatible format) =====
# For Docker, host.docker.internal reaches Ollama running on the Windows host.
# Any non-empty value for API key works.
LLM_API_KEY=ollama
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL_NAME=qwen3.5:9b

# Optional: route ontology and simulation rounds to Groq.
# Set only model IDs available to your Groq account.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_ONTOLOGY_MODEL=
GROQ_SIMULATION_MODEL=
# Graph extraction is separate. Groq's model catalogue lists per-token pricing;
# set these only after confirming your account's free-tier coverage.
GROQ_GRAPH_MODEL=
GROQ_GRAPH_FREE_TIER_CONFIRMED=false
GROQ_GRAPH_TIMEOUT_SECONDS=90

# ===== Neo4j Configuration =====
# The app connects to Neo4j using the Compose service name.
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=mirofish

# ===== Embedding Configuration =====
# Uses Ollama's embedding endpoint
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BASE_URL=http://host.docker.internal:11434

# ===== OASIS / CAMEL-AI Configuration =====
# CAMEL-AI reads OPENAI_API_KEY and OPENAI_API_BASE_URL
# Points to Ollama running on the Windows host.
OPENAI_API_KEY=ollama
OPENAI_API_BASE_URL=http://host.docker.internal:11434/v1
